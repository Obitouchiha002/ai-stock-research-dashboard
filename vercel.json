{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/consolidated?session=am",
      "schedule": "0 3 * * 1-5"
    },
    {
      "path": "/api/cron/consolidated?session=pm",
      "schedule": "30 10 * * 1-5"
    }
  ]
}
