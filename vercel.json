{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/trend-alerts",
      "schedule": "30 22 * * 1-5"
    },
    {
      "path": "/api/cron/monitor",
      "schedule": "*/15 * * * *"
    }
  ]
}
