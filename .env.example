# ---------------------------------------------------------------------------
# StockAnalytix — environment variables
#
# Local dev:  copy this file to `.env.local` and fill in the values.
# Vercel:     add each of these under Project -> Settings -> Environment Variables.
#
# IMPORTANT: no space after "=". `GEMINI_API_KEY= abc` will fail auth.
# Never commit `.env.local` — it is already covered by .gitignore.
# ---------------------------------------------------------------------------

# --- AI providers -----------------------------------------------------------
# At least ONE key is required or every AI feature returns "AI disabled".
# All are recommended: the app falls back across providers when one is
# rate-limited or overloaded, and the Research Dashboard needs at least TWO
# different providers to cross-verify a document's claims.

# Reasoning-heavy tasks (research note, evaluation, import cross-check) and the
# default analyst on the Research Dashboard. Model defaults to claude-opus-4-8;
# override with ANTHROPIC_MODEL. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Reasoning-heavy tasks (research note, evaluation, import cross-check).
OPENAI_API_KEY=

# Middle tier + the only provider that supports Google Search grounding.
GEMINI_API_KEY=

# Fast/light tasks (chat, news summaries).
GROQ_API_KEY=


# --- Daily Digest: live "what changed in 24h" -------------------------------
# Perplexity Sonar API — live web search with citations, used by the Daily
# Digest. Optional: without it the digest falls back to Yahoo news + the AI
# summariser above. Get a key at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# --- Automated daily digest email (local launchd job or Vercel Cron) --------
# Which stocks to digest, comma-separated:
DIGEST_SYMBOLS=AAPL,RELIANCE.NS,TCS.NS
# Where to email it (for Resend no-domain sending, use your resend.com signup email):
DIGEST_EMAIL=
# Resend API key (free at resend.com):
RESEND_API_KEY=
# Sender — the default works without verifying a domain:
RESEND_FROM=Daily Digest <onboarding@resend.dev>
# Trend Alerts email cron — which stocks to monitor (falls back to DIGEST_SYMBOLS):
TREND_SYMBOLS=AAPL,RELIANCE.NS,TCS.NS


# --- Optional model overrides ----------------------------------------------
# Leave blank to use the built-in defaults and fallback chains.
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile


# --- Cloud Sync (multi-device) ---------------------------------------------
# Lets a user link their data across computers/phones with a "sync code"
# (Settings -> Cloud Sync). Backed by an Upstash Redis store over REST.
# Without these, the app still works fully — sync just reports "not set up".
#
# Easiest on Vercel: Project -> Storage -> add "Upstash for Redis". Vercel then
# injects KV_REST_API_URL / KV_REST_API_TOKEN automatically. For local dev or a
# direct Upstash account, use the UPSTASH_* names (create a free DB at
# https://console.upstash.com -> copy "REST API" URL + token).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# --- Optional ---------------------------------------------------------------
# Finnhub is optional; the app falls back to Yahoo Finance when it is absent.
# FINNHUB_API_KEY=
